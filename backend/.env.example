# Chave da IA do FilaVIVA. COPIE este arquivo para backend/.env (ele está no .gitignore) e cole a chave.
# O backend lê backend/.env sozinho ao subir (sem perfil, sem variável de ambiente).
# Modelo (gpt-6.1-sol), esforço (medium) e endereço já estão no código (application.properties).
# Nunca coloque a chave real neste arquivo de exemplo, no código, no Git, em logs ou em variáveis NEXT_PUBLIC_*.

# Chave do 1º provedor (OpenAI). Sem chave o agente fica desligado; o resto do FilaVIVA funciona normalmente.
IA_PROVEDOR_1_CHAVE=

# (opcional) Chave de reserva, usada quando o crédito da 1ª acabar.
IA_PROVEDOR_2_CHAVE=
