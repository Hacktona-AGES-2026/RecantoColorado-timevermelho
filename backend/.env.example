# Variáveis de ambiente do agente de IA. COPIE para um .env local (ele está no .gitignore) e preencha.
# Nunca coloque chaves reais neste arquivo de exemplo, no Git, em logs ou em variáveis NEXT_PUBLIC_*.
# Com o perfil "dotenv" o Spring lê backend/.env sozinho (application-dotenv.properties):
#   cp backend/.env.example backend/.env   e rode com o perfil "dotenv".
# Sem o perfil, exporte as variáveis no terminal ou configure-as na execução do IntelliJ.

# 1º provedor (ChatGPT / OpenAI). Deixe a chave vazia para não usar.
IA_PROVEDOR_1_URL=https://api.openai.com/v1
IA_PROVEDOR_1_CHAVE=
# Modelo: o nome exato de um modelo de chat liberado na sua conta (veja em platform.openai.com/docs/models).
IA_PROVEDOR_1_MODELO=

# 2º provedor, usado quando o crédito do 1º acabar (pode ser outra conta OpenAI ou outra API compatível).
IA_PROVEDOR_2_URL=https://api.openai.com/v1
IA_PROVEDOR_2_CHAVE=
IA_PROVEDOR_2_MODELO=

# Desliga o agente sem mexer no resto da aplicação.
AGENTE_ATIVO=true
